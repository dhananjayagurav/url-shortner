# Copy this file to .env and adjust as needed.
# .env is git-ignored; .env.example is the checked-in template.

# --- Application ---
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_URL=http://localhost:8000

# --- PostgreSQL (Phase 1+) ---
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=urlshortener
POSTGRES_DB=urlshortener
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://urlshortener:urlshortener@localhost:5432/urlshortener

# --- Redis (introduced Phase 6) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Kafka (introduced Phase 11) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
